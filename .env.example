# ── Supabase (REQUIRED — the app will not boot without these) ────────────────
# Project Settings → API in the Supabase dashboard
# TWO environments since Sep 21 2026: this file's shape is .env.local (STAGING —
# dev, e2e, check:schema). Production's three Supabase values live in .env.prod,
# read only by TARGET_ENV=prod scripts. See CLAUDE.md → Environments.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser, mark Sensitive in Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GIFs (required for GIF picker in messages/comments) ──────────────────────
GIPHY_API_KEY=your-giphy-api-key

# ── Sentry error monitoring (optional — Sentry is a no-op without the DSN) ───
# Project Settings → Client Keys (DSN) in the Sentry dashboard. Safe for the
# browser (a DSN only lets clients SUBMIT events).
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# Optional: forces the Sentry `environment` tag. Normally unnecessary — Vercel
# supplies NEXT_PUBLIC_VERCEL_ENV automatically (Project Settings →
# "Automatically expose System Environment Variables"), and local dev falls
# back to 'development'. Set this per Vercel Environment only if that toggle
# is off, or a preview deployment would report itself as 'production'.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=preview
# Optional, build-time only: enables readable stack traces (source-map upload).
# Sentry → Settings → Auth Tokens (scope: project:releases). Mark Sensitive.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Admin (optional) ──────────────────────────────────────────────────────────
# Comma-separated emails allowed into /dashboard (reports queue, user lookup)
ADMIN_EMAILS=you@example.com

# ── Feature flags (build-time — NEXT_PUBLIC_* is inlined; changing one in
# Vercel needs a redeploy). All launched to prod; keep set to 1 there.
# Guardian profiles need migrations 048-051 run first; calendar needs 057.
NEXT_PUBLIC_FEATURE_GUARDIAN_PROFILES=1
NEXT_PUBLIC_FEATURE_CALENDAR=1
NEXT_PUBLIC_FEATURE_CHAT_DOCK=1

# ── OAuth sign-in (build-time flags, same inlining caveat as above) ──────────
# Code is complete; the flag only shows the buttons. Enabling for real also
# needs the provider configured in Supabase (Auth → Providers) and, for
# Google, the console client — see docs/LAUNCH_RUNBOOK.md.
# NEXT_PUBLIC_OAUTH_GOOGLE=1
# Apple additionally requires an Apple Developer account.
# NEXT_PUBLIC_OAUTH_APPLE=1

# ── Golf course catalog providers (src/lib/golf/course-catalog.ts) ───────────
# OpenGolfAPI (US courses) is KEYLESS and on by default; set
# GOLF_OPENGOLFAPI_DISABLED=1 to turn it off. GolfCourseAPI adds worldwide
# coverage and needs a key (free tier = 50 requests/DAY — the code
# budget-guards it; providers are only called on explicit "search worldwide"
# and on first selection of a new course, never per keystroke). No key set →
# catalog + courses-you've-played only, which is a supported state.
GOLF_COURSE_API_KEY=your-golfcourseapi-key
# GOLF_PROVIDER_DAILY_BUDGET=45
# GOLF_OPENGOLFAPI_DISABLED=1
# The plan the key is on: free (default) | pro | enterprise. GolfCourseAPI
# v1.3.0's /v1/proximity ("courses near me", with coordinates) is Pro and up;
# on free it is never called and spends nothing. On pro raise the daily
# budget (the plan allows 10,000/day) and optionally cap proximity's own share.
# GOLF_COURSE_API_PLAN=free
# GOLF_PROXIMITY_DAILY_BUDGET=500
# Elevation "plays like" on the scorer (migration 254). The FIRST provider is
# AWS Open Data's Terrain Tiles (Mapzen) — free, no key, attribution only
# (docs/GOLF_COURSE_DATA.md) — so nothing here is required. Open-Meteo's
# Elevation API, through its COMMERCIAL host, is the FALLBACK when the tiles
# cannot be reached, and only with this key set.
# OPEN_METEO_API_KEY=your-open-meteo-key

# ── Cron (notification digest) ────────────────────────────────────────────────
# Required for the daily email-digest cron. Vercel sends this as a Bearer token;
# the route rejects requests without it. Generate any long random string.
CRON_SECRET=your-long-random-string
# Absolute app URL used in digest email links (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Site analytics (program 2, E) ─────────────────────────────────────────────
# The daily salt for the org-site page-view pixel's visitor marks (a
# per-day HMAC — the same browser is one visitor for a day and unlinkable
# the next). Any long random string. Unset: the pixel answers but nothing
# is counted (a supported state).
ANALYTICS_SALT=your-long-random-string

# ── Optional: Email (contact form + digests) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
CONTACT_EMAIL=your_email@gmail.com

# ── Optional: Brand logos in the equipment picker ─────────────────────────────
# Publishable Logo.dev token (https://logo.dev). Unset → the brand picker shows
# initial-letter tiles instead, which is a supported state, not a broken one.
# NEXT_PUBLIC_* is INLINED AT BUILD TIME: setting this in Vercel needs a
# redeploy before it takes effect.
NEXT_PUBLIC_LOGO_DEV_TOKEN=pk_your_publishable_token

# ── Optional: e2e admin-positive specs ────────────────────────────────────────
# An address the build lists in ADMIN_EMAILS that NO real account owns. The
# admin-positive Playwright specs (e2e/admin-site-metrics.spec.ts) create a
# disposable user with exactly this address, mint its session, and delete it
# afterwards; unset → those specs skip with a reason. Keep the edgeqa- prefix
# so the stale-user sweep also covers it.
# ADMIN_EMAILS=edgeqa-admin@example.com
# E2E_ADMIN_EMAIL=edgeqa-admin@example.com

# Optional: verify sessions locally (speed round 2, Oct 2026). The project's
# JWT secret (Supabase → Project Settings → API → JWT Secret). With it set,
# every API call and page load checks the access token here instead of asking
# Supabase Auth over the network (100–300 ms). Unset = the network check.
# Server-only — never NEXT_PUBLIC_. Pair it with a 10-minute access-token
# lifetime (Auth → Sessions): a suspended account keeps READ access for at
# most that long; writes are refused at once regardless.
SUPABASE_JWT_SECRET=

# Optional: the installed app's static cache (speed round 2, Oct 2026). With
# it set, the service worker is registered at boot and answers /_next/static/*
# (hashed, immutable) from a cache — nothing else is ever cached. Preview
# first, then a real iPhone, then production. NEXT_PUBLIC_* is inlined at
# BUILD time — a real build, not a redeploy.
NEXT_PUBLIC_SW_STATIC_CACHE=
