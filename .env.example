# ── Supabase (REQUIRED — the app will not boot without these) ────────────────
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser, mark Sensitive in Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GIFs (required for GIF picker in messages/comments) ──────────────────────
GIPHY_API_KEY=your-giphy-api-key

# ── Sentry error monitoring (optional — Sentry is a no-op without the DSN) ───
# Project Settings → Client Keys (DSN) in the Sentry dashboard. Safe for the
# browser (a DSN only lets clients SUBMIT events).
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# Optional: forces the Sentry `environment` tag. Normally unnecessary — Vercel
# supplies NEXT_PUBLIC_VERCEL_ENV automatically (Project Settings →
# "Automatically expose System Environment Variables"), and local dev falls
# back to 'development'. Set this per Vercel Environment only if that toggle
# is off, or a preview deployment would report itself as 'production'.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=preview
# Optional, build-time only: enables readable stack traces (source-map upload).
# Sentry → Settings → Auth Tokens (scope: project:releases). Mark Sensitive.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Admin (optional) ──────────────────────────────────────────────────────────
# Comma-separated emails allowed into /dashboard (reports queue, user lookup)
ADMIN_EMAILS=you@example.com

# ── Optional: AI features ─────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Cron (notification digest) ────────────────────────────────────────────────
# Required for the daily email-digest cron. Vercel sends this as a Bearer token;
# the route rejects requests without it. Generate any long random string.
CRON_SECRET=your-long-random-string
# Absolute app URL used in digest email links (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Optional: Email (contact form + digests) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
CONTACT_EMAIL=your_email@gmail.com
